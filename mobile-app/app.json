{
  "expo": {
    "name": "工参地图",
    "slug": "network-planning-mobile",
    "version": "1.0.0",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.gongcan.map",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-asset"
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
